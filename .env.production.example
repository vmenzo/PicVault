POSTGRES_USER=picvault
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=picvault

APP_HOST_PORT=7899
# Default bind is loopback only: the app is not reachable from the LAN or
# the internet until you put a reverse proxy (nginx/Caddy, see ops/) in
# front of it. Override to 0.0.0.0 only if you understand the exposure,
# or to a Docker-bridge IP (e.g. 172.17.0.1) for a proxy running in a
# container on the default bridge network.
APP_BIND_ADDRESS=127.0.0.1
# Backup location, as seen from INSIDE the backend container. The host
# scripts (scripts/backup.sh, scripts/restore.sh) source this file and map
# /app/backups to <install-dir>/backups on the host; the backend's
# maintenance view reads the same value inside the container. Do not set
# this to a host-only absolute path.
PICVAULT_BACKUP_DIR=/app/backups
ALLOW_REGISTER=false
VITE_ALLOW_REGISTER=false
APP_PUBLIC_URL=https://your-domain.example

TRUST_PROXY=loopback, linklocal, uniquelocal
# HTTPS auto-hardening: scripts/install.sh sets ENABLE_HSTS=true and
# TRUST_PROXY_HEADERS=true automatically when APP_PUBLIC_URL starts with
# https:// (fresh installs, or when the keys are absent on re-runs).
# If you edit APP_PUBLIC_URL by hand, set these two to true yourself.
ENABLE_HSTS=false
TRUST_PROXY_HEADERS=false
FRAME_ANCESTORS=self
TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_MINUTES=30
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
ENABLE_SWAGGER=false

S3_ENDPOINT=
S3_UPLOAD_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
PUBLIC_IMAGE_BASE_URL=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
